# ===== 简历润笔 ResumePolish 环境变量示例 =====
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实 Key。
# 注意：以下变量仅服务端（Serverless / 本地服务器）读取，前端 bundle 不包含任何 Key。

# LLM API（OpenAI 兼容协议，默认 DeepSeek；留空则自动进入 Mock 演示模式）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 本地开发服务器端口（vite dev server 通过代理转发 /api 到此端口）
PORT=8787
